#!/usr/bin/env bash

# ============================================================
# startup — установка окружения: nvm/Node, docker-compose,
# proxychains4, headless Google Chrome (через proxychains4)
# ============================================================

# Не используем set -e "в лоб": обрабатываем ошибки сами через retry/проверки,
# чтобы один сбой сети не убивал весь скрипт посреди установки.
set -uo pipefail

# Версия Node.js по умолчанию
NODE_VERSION="${1:-24.22.1}"

# Версия Docker Compose
DOCKER_COMPOSE_VERSION="${DOCKER_COMPOSE_VERSION:-v2.39.2}"

# Количество попыток для сетевых операций
RETRY_LIMIT="${RETRY_LIMIT:-3}"
# Пауза между попытками, секунд
RETRY_DELAY="${RETRY_DELAY:-5}"

# Цвета для вывода
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

err() {
    echo -e "${RED}[ERROR]${NC} $1"
    # НЕ выходим сразу — стараемся продолжить установку остальных компонентов
}

# Пауза перед выходом, чтобы окно tmux не закрылось и был виден результат
finish() {
    echo ""
    read -rp "Установка завершена. Нажмите Enter, чтобы закрыть окно..."
}
trap finish EXIT

# retry: запускает команду несколько раз с задержкой
# Использование: retry <cmd...>
retry() {
    local attempt=1
    local cmd
    until "$@"; do
        cmd="$*"
        if (( attempt >= RETRY_LIMIT )); then
            warn "Не удалось выполнить за $RETRY_LIMIT попыток: $cmd"
            return 1
        fi
        warn "Попытка $attempt/$RETRY_LIMIT не удалась: $cmd"
        warn "Повтор через ${RETRY_DELAY}с..."
        sleep "$RETRY_DELAY"
        attempt=$((attempt + 1))
    done
    return 0
}

# Проверка root
if [[ $EUID -eq 0 ]]; then
    err "Не запускайте этот скрипт от root. Используйте пользователя с правами sudo."
    exit 1
fi

# Определение архитектуры и ОС
ARCH="$(uname -m)"
OS="$(uname -s)"

case "$ARCH" in
    x86_64) ARCH_BIN="x86_64" ;;
    aarch64|arm64) ARCH_BIN="aarch64" ;;
    *) err "Неподдерживаемая архитектура: $ARCH"; exit 1 ;;
esac

# Запрос файла с прокси
echo ""
read -rp "Путь к файлу с прокси (оставьте пустым, чтобы скачивать без proxychains4): " PROXY_FILE_INPUT
echo ""

PROXYCHAINS_ENABLED=false
PROXYCHAINS_CONF="/etc/proxychains4.conf"

if [[ -n "${PROXY_FILE_INPUT// }" ]]; then
    PROXY_FILE="$(realpath "${PROXY_FILE_INPUT// }" 2>/dev/null || echo "${PROXY_FILE_INPUT// }")"
    if [[ -f "$PROXY_FILE" ]]; then
        log "Найден файл с прокси: $PROXY_FILE"
        PROXYCHAINS_ENABLED=true
    else
        warn "Файл $PROXY_FILE не найден. Будем скачивать без proxychains4."
    fi
else
    log "Путь к файлу с прокси не указан. Будем скачивать без proxychains4."
fi

log "Начинаем установку окружения..."
log "Версия Node.js: $NODE_VERSION"
log "Версия Docker Compose: $DOCKER_COMPOSE_VERSION"
log "Ошибки сети будут обрабатываться: до $RETRY_LIMIT попыток на каждую операцию."
if [[ "$PROXYCHAINS_ENABLED" == true ]]; then
    log "Режим загрузки Chrome: через proxychains4 (с фолбэком на прямое соединение)"
else
    log "Режим загрузки Chrome: напрямую"
fi

FAILED_STEPS=()

# Восстановление прерванного dpkg: иначе любая apt-операция упадёт
# с ошибкой "dpkg was interrupted, you must manually run 'sudo dpkg --configure -a'"
fix_dpkg() {
    log "Проверяем наличие незавершённых установок dpkg..."
    if sudo dpkg --audit 2>/dev/null | grep -q . ; then
        log "Найдены незавершённые пакеты, запускаем 'dpkg --configure -a'..."
        retry sudo dpkg --configure -a || warn "Не удалось донастроить dpkg автоматически."
    fi
    # Ждём, если apt/dpkg держит lock (например, конкурирующий apt-процесс)
    for ((i = 1; i <= RETRY_LIMIT; i++)); do
        if sudo fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; then
            warn "apt/dpkg занят другим процессом. Ждём ${RETRY_DELAY}с..."
            sleep "$RETRY_DELAY"
        else
            return 0
        fi
    done
    warn "Амалlock apt всё ещё занят — продолжаем и посмотрим, что получится."
    return 0
}

if fix_dpkg; then :; fi

# Обновление пакетов
log "Обновляем список пакетов..."
if ! retry sudo apt-get update -y; then
    warn "apt-get update не удался — продолжаем, пакеты могут установиться из кэша."
    FAILED_STEPS+=("apt-get update")
fi

# Установка базовых зависимостей
log "Устанавливаем базовые зависимости..."
if ! retry sudo apt-get install -y \
    curl \
    wget \
    ca-certificates \
    gnupg \
    lsb-release \
    apt-transport-https \
    software-properties-common \
    unzip \
    coreutils; then
    warn "Не все базовые зависимости установились. Пробуем ещё раз после восстановления dpkg..."
    fix_dpkg
    if retry sudo apt-get install -y \
        curl \
        wget \
        ca-certificates \
        gnupg \
        lsb-release \
        apt-transport-https \
        software-properties-common \
        unzip \
        coreutils; then
        log "Базовые зависимости установлены со второй попытки."
    else
        warn "Не все базовые зависимости установились — продолжаем, но возможны сбои дальше."
        FAILED_STEPS+=("базовые зависимости")
    fi
fi

# 1) Установка Node.js через nvm
log "[1/7] Установка Node.js через nvm..."

export NVM_DIR="$HOME/.nvm"

if [[ ! -d "$NVM_DIR" ]]; then
    log "nvm не найден. Устанавливаем..."
    if ! retry curl -fsSL -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.8/install.sh | bash; then
        warn "Не удалось установить nvm. Node.js пропущен."
        FAILED_STEPS+=("nvm")
        SKIP_NODE=true
    fi
else
    log "nvm уже установлен."
fi

if [[ "${SKIP_NODE:-false}" != true ]]; then
    # Загрузка nvm
    # shellcheck disable=SC1091
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    # shellcheck disable=SC1091
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

    if command -v nvm >/dev/null 2>&1; then
        log "Устанавливаем Node.js $NODE_VERSION..."
        if retry nvm install "$NODE_VERSION"; then
            nvm use "$NODE_VERSION" || true
            nvm alias default "$NODE_VERSION" || true
            log "Node.js установлен: $(node -v 2>/dev/null || echo 'н/д')"
            log "npm установлен: $(npm -v 2>/dev/null || echo 'н/д')"
        else
            warn "Не удалось установить Node.js $NODE_VERSION."
            FAILED_STEPS+=("Node.js $NODE_VERSION")
        fi
    else
        warn "nvm недоступен после установки. Node.js пропущен."
        FAILED_STEPS+=("nvm (не загрузился)")
    fi
fi

# 2) Установка Docker Compose
log "[2/7] Установка Docker Compose..."

DOCKER_COMPOSE_BIN="/usr/local/bin/docker-compose"

if [[ -f "$DOCKER_COMPOSE_BIN" ]]; then
    warn "docker-compose уже существует по пути $DOCKER_COMPOSE_BIN. Будет перезаписан."
fi

log "Скачиваем docker-compose ${DOCKER_COMPOSE_VERSION} для ${OS}-${ARCH_BIN}..."
if retry sudo curl -fL --retry 2 "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-${OS}-${ARCH_BIN}" \
    -o "$DOCKER_COMPOSE_BIN"; then
    sudo chmod +x "$DOCKER_COMPOSE_BIN"
    log "Docker Compose установлен: $(docker-compose --version 2>/dev/null || echo 'н/д')"
else
    warn "Не удалось скачать docker-compose."
    FAILED_STEPS+=("docker-compose")
fi

# 3) Установка proxychains4
log "[3/7] Установка proxychains4..."

if command -v proxychains4 >/dev/null 2>&1; then
    log "proxychains4 уже установлен."
else
    if retry sudo apt-get install -y proxychains4; then
        log "proxychains4 установлен."
    else
        warn "Не удалось установить proxychains4. Загрузка Chrome пойдёт напрямую."
        PROXYCHAINS_ENABLED=false
        FAILED_STEPS+=("proxychains4")
    fi
fi

# Настройка proxychains4 при наличии файла с прокси
if [[ "$PROXYCHAINS_ENABLED" == true ]]; then
    log "Настраиваем proxychains4 на основе файла с прокси..."

    if [[ -f "$PROXYCHAINS_CONF" ]]; then
        if [[ ! -f "${PROXYCHAINS_CONF}.bak" ]]; then
            log "Создаём бэкап конфигурации $PROXYCHAINS_CONF..."
            sudo cp "$PROXYCHAINS_CONF" "${PROXYCHAINS_CONF}.bak"
        else
            log "Бэкап ${PROXYCHAINS_CONF}.bak уже существует, перезаписывать не будем."
        fi
    fi

    TMP_CONF="$(mktemp)"
    {
        echo "# Сконфигурирован автоматически startup-скриптом"
        echo "random_chain"
        echo "# Сколько прокси использовать в цепочке (1 = каждый коннект через случайный один прокси)"
        echo "chain_len = 1"
        echo "proxy_dns"
        echo "remote_dns_subnet 224"
        echo "tcp_read_time_out 15000"
        echo "tcp_connect_time_out 8000"
        echo "localnet 127.0.0.0/255.0.0.0"
        echo "[ProxyList]"
        echo "# type  host  port  [user pass]"
    } > "$TMP_CONF"

    # Парсинг файла формата: http ip port user pass
    while IFS=$' \t\r\n' read -r ptype phost pport puser ppass || [[ -n "${ptype:-}" ]]; do
        # Пропуск пустых строк и комментариев
        [[ -z "${ptype:-}" ]] && continue
        [[ "${ptype:0:1}" == "#" ]] && continue
        # Проверяем, что строка полностью распарсилась
        if [[ -z "${phost:-}" || -z "${pport:-}" || -z "${puser:-}" || -z "${ppass:-}" ]]; then
            warn "Пропущена неполная строка в файле прокси: $ptype ${phost:-} ${pport:-}"
            continue
        fi
        echo "$ptype $phost $pport $puser $ppass" >> "$TMP_CONF"
    done < "$PROXY_FILE"

    PROXY_COUNT="$(grep -cE '^[[:space:]]*(http|socks4|socks5)[[:space:]]+' "$TMP_CONF" || true)"
    if [[ "$PROXY_COUNT" -eq 0 ]]; then
        rm -f "$TMP_CONF"
        warn "В файле $PROXY_FILE нет валидных прокси. Загрузка Chrome пойдёт напрямую."
        PROXYCHAINS_ENABLED=false
    else
        log "Добавлено прокси в конфиг: $PROXY_COUNT"
        sudo cp "$TMP_CONF" "$PROXYCHAINS_CONF"
        sudo chmod 644 "$PROXYCHAINS_CONF"
        rm -f "$TMP_CONF"
        log "proxychains4 настроен. Конфиг: $PROXYCHAINS_CONF"
    fi
fi

# 4) Скачивание и установка headless-версии Google Chrome
log "[4/7] Скачивание и установка Google Chrome (headless)..."

if command -v google-chrome-stable >/dev/null 2>&1 && google-chrome-stable --version >/dev/null 2>&1; then
    log "Google Chrome уже установлен: $(google-chrome-stable --version 2>/dev/null || true). Этап пропускается."
else
    CHROME_DEB="/tmp/google-chrome-stable_current_amd64.deb"
    CHROME_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"

    # Удаляем старый .deb если есть
    rm -f "$CHROME_DEB"

    CHROME_DOWNLOADED=false

    if [[ "$PROXYCHAINS_ENABLED" == true ]]; then
        log "Скачиваем Chrome через proxychains4 (попытки: $RETRY_LIMIT)..."
        for ((i = 1; i <= RETRY_LIMIT; i++)); do
            if proxychains4 -q wget -q --timeout=60 -O "$CHROME_DEB" "$CHROME_URL" && [[ -s "$CHROME_DEB" ]]; then
                CHROME_DOWNLOADED=true
                break
            fi
            warn "Попытка $i/$RETRY_LIMIT скачать Chrome через proxychains4 не удалась (мёртвый прокси?)."
            sleep "$RETRY_DELAY"
        done

        # Фолбэк: пробуем через отдельный прокси-адрес из файла (по одному),
        # а затем — напрямую
        if [[ "$CHROME_DOWNLOADED" != true ]]; then
            log "Цепочка не сработала. Пробуем прокси по одному..."
            while IFS=$' \t\r\n' read -r ptype phost pport puser ppass || [[ -n "${ptype:-}" ]]; do
                [[ -z "${ptype:-}" || "${ptype:0:1}" == "#" ]] && continue
                [[ -z "${phost:-}" || -z "${pport:-}" || -z "${puser:-}" || -z "${ppass:-}" ]] && continue
                rm -f "$CHROME_DEB"
                echo "$ptype $phost $pport $puser $ppass" > /tmp/single_proxy.conf
                cat > /tmp/single_pc.conf <<EOF
random_chain
chain_len = 1
proxy_dns
tcp_read_time_out 15000
tcp_connect_time_out 8000
localnet 127.0.0.0/255.0.0.0
[ProxyList]
$(cat /tmp/single_proxy.conf)
EOF
                log "Пробуем $ptype $phost:$pport ..."
                if proxychains4 -q -f /tmp/single_pc.conf wget -q --timeout=60 -O "$CHROME_DEB" "$CHROME_URL" && [[ -s "$CHROME_DEB" ]]; then
                    log "Сработало: $phost:$pport"
                    CHROME_DOWNLOADED=true
                    break
                fi
            done < "$PROXY_FILE"
        fi
    fi

    if [[ "$CHROME_DOWNLOADED" != true ]]; then
        warn "Через прокси скачать не удалось. Фолбэк: прямое соединение..."
        rm -f "$CHROME_DEB"
        if wget -q --timeout=60 -O "$CHROME_DEB" "$CHROME_URL" && [[ -s "$CHROME_DEB" ]]; then
            CHROME_DOWNLOADED=true
        fi
    fi

    if [[ "$CHROME_DOWNLOADED" == true ]]; then
        log "Устанавливаем Google Chrome..."
        sudo dpkg -i "$CHROME_DEB" 2>/dev/null || true
        log "Исправляем зависимости..."
        retry sudo apt-get install -f -y || true

        # Удаляем временный файл
        rm -f "$CHROME_DEB" /tmp/single_proxy.conf /tmp/single_pc.conf
    else
        warn "Chrome скачать не удалось ни через прокси, ни напрямую."
        FAILED_STEPS+=("Google Chrome (загрузка)")
    fi
fi

if command -v google-chrome-stable >/dev/null 2>&1; then
    log "Google Chrome установлен: $(google-chrome-stable --version)"
    log "Headless-запуск: google-chrome-stable --headless --disable-gpu --no-sandbox --remote-debugging-port=9222 about:blank"
elif [[ "$CHROME_DOWNLOADED" == true ]]; then
    warn "Chrome не установился (не хватило зависимостей?). Проверьте apt."
    FAILED_STEPS+=("Google Chrome")
fi

# 5) Установка wakaru (npm global)
log "[5/7] Установка wakaru (npm install -g wakaru@latest)..."

if ! command -v npm >/dev/null 2>&1; then
    warn "npm не найден (Node.js не установлен?). wakaru пропущен."
    FAILED_STEPS+=("wakaru (нет npm)")
else
    if retry npm install -g wakaru@latest; then
        # Проверка успешной установки
        WAKARU_VERSION="$(wakaru --version 2>/dev/null || true)"
        if command -v wakaru >/dev/null 2>&1 && [[ -n "$WAKARU_VERSION" ]]; then
            log "wakaru установлен: v$WAKARU_VERSION"
        elif command -v wakaru >/dev/null 2>&1; then
            log "wakaru установлен (бинарник найден), но --version ничего не вернул."
        else
            warn "wakaru не найден в PATH после установки. Проверьте: npm ls -g wakaru"
            FAILED_STEPS+=("wakaru (не найден в PATH)")
        fi
    else
        warn "Не удалось установить wakaru через npm."
        FAILED_STEPS+=("wakaru (установка)")
    fi
fi

# 6) Установка webcrack (npm global)
log "[6/7] Установка webcrack (npm install -g webcrack@latest)..."

if ! command -v npm >/dev/null 2>&1; then
    warn "npm не найден (Node.js не установлен?). webcrack пропущен."
    FAILED_STEPS+=("webcrack (нет npm)")
else
    if retry npm install -g webcrack@latest; then
        if command -v webcrack >/dev/null 2>&1; then
            log "webcrack установлен."
        else
            warn "webcrack не найден в PATH после установки. Проверьте: npm ls -g webcrack"
            FAILED_STEPS+=("webcrack (не найден в PATH)")
        fi
    else
        warn "Не удалось установить webcrack через npm."
        FAILED_STEPS+=("webcrack (установка)")
    fi
fi

# 7) Установка набора скиллов
log "[7/7] Установка набора скиллов (npx skills add pionxzh/wakaru)..."

if ! command -v npm >/dev/null 2>&1; then
    warn "npm не найден. Скиллы пропущены."
    FAILED_STEPS+=("skills (нет npm)")
else
    # npx -y — чтобы не зависнуть на интерактивном вопросе об установке пакета
    if retry npx -y skills add pionxzh/wakaru; then
        log "Скиллы pionxzh/wakaru установлены."
    else
        warn "Не удалось установить скиллы pionxzh/wakaru."
        FAILED_STEPS+=("skills (установка)")
    fi
fi

# Итоги
echo ""
echo -e "${GREEN}============================================================${NC}"
if [[ ${#FAILED_STEPS[@]} -eq 0 ]]; then
    log "Все этапы завершены успешно!"
else
    warn "Установка завершена, но были проблемы на этапах:"
    for step in "${FAILED_STEPS[@]}"; do
        echo -e "${YELLOW}  - $step${NC}"
    done
    echo ""
    log "Сетевые шаги можно перезапустить повторным запуском скрипта —"
    log "он идемпотентен: уже установленные компоненты не сломаются."
fi
echo -e "${GREEN}============================================================${NC}"
log "Рекомендуется перезапустить shell или выполнить: source ~/.bashrc (или ~/.zshrc)"
